# =========================================================================
# CareerConnect Environment Variables Template
# =========================================================================

# --- Django Security (Generate a secure secret key for production) ---
SECRET_KEY=django-insecure-careerconnect-2026-secret-key-production-ready
DEBUG=True

# --- Allowed Hosts (Comma-separated) ---
# On Vercel: include your .vercel.app domain (e.g. your-app.vercel.app,127.0.0.1,localhost)
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,.vercel.app

# --- CSRF Trusted Origins (Comma-separated) ---
# Required for Django 4/5/6 POST forms in production HTTPS
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://127.0.0.1:8000,http://localhost:8000

# =========================================================================
# Database Configuration
# =========================================================================
# 1. Local Development (Default): Leave DATABASE_URL empty to use db.sqlite3
# DATABASE_URL=

# 2. Production Cloud Database on Vercel (Neon / Supabase / Railway / RDS):
# DATABASE_URL=postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/careerconnect_db?sslmode=require

# 3. Dedicated MySQL Database:
# DB_ENGINE=mysql
# DB_NAME=careerconnect_db
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
